# Public web configuration from Firebase Project settings > Your apps.
# Never put service-account credentials or provider secrets in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local mock service only. Rejected in production; no cloud project needed.
VITE_FIREBASE_AUTH_EMULATOR=false
